<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.88</Version>
    <AssemblyName>VRMGalgame</AssemblyName>
    <ApplicationTitle>公民文艺生产综合自动化系统</ApplicationTitle>
    <AssemblyTitle>公民文艺生产综合自动化系统</AssemblyTitle>
    <Product>公民文艺生产综合自动化系统</Product>
    <Description>公民文艺生产综合自动化系统</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" /></ItemGroup>
  <ItemGroup><PackageReference Include="SharpZipLib" Version="1.4.2" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="engine-attribution.json" LogicalName="VRMGalgame.engine-attribution.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="app.ico" LogicalName="VRMGalgame.app.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../src/editor-languages.json" LogicalName="VRMGalgame.editor-languages.json" /></ItemGroup>
</Project>
