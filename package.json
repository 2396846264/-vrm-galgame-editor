{
  "name": "vrm-galgame-editor",
  "private": true,
  "version": "0.7.89",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/copy-pdf-resources.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:fixtures": "node scripts/run-tests.mjs --with-fixtures",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test",
    "format:modules": "prettier --write \"src/{platform,project,player,events,rendering,combat,agent,editor,ui}/**/*.js\"",
    "format:check": "prettier --check \"src/{platform,project,player,events,rendering,combat,agent,editor,ui}/**/*.js\""
  },
  "dependencies": {
    "@moeru/three-mmd": "0.0.5",
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "mmd-parser": "1.1.4",
    "pdfjs-dist": "^6.3.289",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "^7.3.0"
  }
}
